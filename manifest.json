{
  "manifest_version": 3,
  "name": "No Super Chat",
  "version": "1.2.1",
  "description": "Hides the Super Chat button in YouTube live chat, or caps Super Chat spending per day.",
  "permissions": ["storage"],
  "action": {
    "default_title": "No Super Chat",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "css": ["hide.css"],
      "js": ["hide.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
